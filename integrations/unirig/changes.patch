--- /dev/null
+++ b/src/model/portable_generation.py
@@ -0,0 +1,19 @@
+"""Model-local empty-history repetition guard, no installed-library patch."""
+from types import MethodType
+from transformers.generation.logits_process import RepetitionPenaltyLogitsProcessor
+
+class EmptyHistorySafeRepetitionPenalty(RepetitionPenaltyLogitsProcessor):
+ def __call__(self,input_ids,scores):
+  history=input_ids[:,self.prompt_ignore_length:] if self.prompt_ignore_length else input_ids
+  return scores if history.numel()==0 else super().__call__(input_ids,scores)
+
+def install_empty_history_repetition_guard(transformer):
+ if getattr(transformer,'_unirig_generation_guard_installed',False):return
+ original=transformer._get_logits_processor.__func__
+ def guarded(self,*args,**kwargs):
+  processors=original(self,*args,**kwargs)
+  for index,processor in enumerate(processors):
+   if type(processor) is RepetitionPenaltyLogitsProcessor:
+    replacement=EmptyHistorySafeRepetitionPenalty(processor.penalty);replacement.__dict__.update(processor.__dict__);processors[index]=replacement
+  return processors
+ transformer._get_logits_processor=MethodType(guarded,transformer);transformer._unirig_generation_guard_installed=True
