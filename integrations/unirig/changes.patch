diff --git a/src/model/portable_fps.py b/src/model/portable_fps.py
new file mode 100644
index 0000000..82f1fd3
--- /dev/null
+++ b/src/model/portable_fps.py
@@ -0,0 +1,22 @@
+"""Deterministic CPU FPS for the external skeleton research runtime.
+
+Matches the eval-mode algorithm/count/tie rules in pytorch_cluster's CPU FPS:
+https://github.com/rusty1s/pytorch_cluster/blob/master/csrc/cpu/fps_cpu.cpp
+No compiled extension or GPU kernel is used for point selection.
+"""
+import numpy as np
+import torch
+
+def fps(x,batch,ratio,random_start=False):
+ if random_start:raise ValueError('research FPS supports deterministic inference only')
+ if x.ndim!=2 or batch.ndim!=1 or len(x)!=len(batch) or not 0<ratio<=1:raise ValueError('invalid FPS points, batch or ratio')
+ points=x.detach().cpu().numpy();labels=batch.detach().cpu().numpy()
+ if not np.isfinite(points).all() or np.any(labels<0) or np.any(labels[1:]<labels[:-1]):raise ValueError('FPS requires finite points and sorted nonnegative batch labels')
+ result=[]
+ for label in np.unique(labels):
+  indices=np.flatnonzero(labels==label);p=points[indices];count=int(np.ceil(np.float32(len(p))*np.float32(ratio)))
+  start=0;distance=np.sum((p-p[start])**2,axis=1);selected=[indices[start]]
+  for _ in range(1,count):
+   start=int(np.argmax(distance));selected.append(indices[start]);distance=np.minimum(distance,np.sum((p-p[start])**2,axis=1))
+  result.extend(selected)
+ return torch.tensor(result,dtype=torch.long,device=x.device)
