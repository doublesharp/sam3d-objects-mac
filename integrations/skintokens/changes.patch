+ parents=raw_parents.astype(np.int64)
+ if np.any((parents< -1)|(parents>=len(joints))) or np.count_nonzero(parents==-1)!=1:raise ValueError('parents require one root and valid indices')
+ for i in range(len(parents)):
+  seen=set();current=i
+  while current!=-1:
+   if current in seen:raise ValueError('skeleton contains a parent cycle')
+   seen.add(current);current=int(parents[current])
+ return joints,parents
+
+def validate_rig(joints,parents,weights,vertex_count):
+ validate_skeleton(joints,parents);weights=np.asarray(weights)
+ if weights.shape!=(vertex_count,len(joints)) or not np.isfinite(weights).all():raise ValueError('weights must be finite with one row per source vertex and one column per joint')
