+from src.tokenizer.parse import get_tokenizer
+from src.tokenizer.spec import TokenizeInput
+
+def tokenizer():
+ return get_tokenizer(__target__='tokenizer_part',num_discrete=256,continuous_range=[-1,1],cls_token_id={'articulation':0},parts_token_id={'body':0,'hand':1})
+
+def check(parents):
+ t=tokenizer();joints=np.stack([np.linspace(-.8,.8,len(parents)),np.linspace(.1,.9,len(parents)),np.linspace(-.3,.6,len(parents))],1)
+ sk=t.tokenize(TokenizeInput(joints=joints,parents=parents,cls='articulation'));J=t.bones_in_sequence(sk);assert J==len(parents)
+ eos=t.vocab_size+32768;proc=VocabSwitchingLogitsProcessor(t,t.eos,eos,4,torch.tensor(sk))
+ for count in [0,J*4-1,J*4]:
+  score=proc(torch.full((1,count),t.vocab_size),torch.zeros(1,eos+1))[0]
+  if count==J*4:
+   assert torch.isfinite(score[eos]);assert torch.isfinite(score).sum()==1
+  else:
+   assert not torch.isfinite(score[eos]);assert torch.isfinite(score[t.vocab_size]);assert not torch.isfinite(score[:t.vocab_size]).any()
+ print('PASS',parents,'complete skin count',J*4)
+for p in [[-1],[-1,0,1],[-1,0,0,2]]:check(p)
