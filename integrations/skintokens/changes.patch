+
+def validate_override(actual_joints,actual_parents,supplied_joints,supplied_parents):
+ validate_skeleton(supplied_joints,supplied_parents)
+ if not np.array_equal(actual_parents,supplied_parents):raise ValueError('generated parents differ from supplied skeleton')
