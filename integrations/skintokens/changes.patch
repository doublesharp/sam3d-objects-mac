+def install_empty_history_repetition_guard(transformer):
+    """Replace resolved stock penalties in place, on this model only."""
+    if getattr(transformer, '_skintokens_generation_guard_installed', False):
+        return
+    original = transformer._get_logits_processor.__func__
+
+    def guarded(self, *args, **kwargs):
+        processors = original(self, *args, **kwargs)
+        for index, processor in enumerate(processors):
+            if type(processor) is RepetitionPenaltyLogitsProcessor:
+                replacement = EmptyHistorySafeRepetitionPenalty(processor.penalty)
+                replacement.__dict__.update(processor.__dict__)
+                processors[index] = replacement
+        return processors
+
+    transformer._get_logits_processor = MethodType(guarded, transformer)
+    transformer._skintokens_generation_guard_installed = True
 
