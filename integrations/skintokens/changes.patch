+from src.model import tokenrig
+from src.tokenizer.parse import get_tokenizer
+
+torch.set_num_threads(2)
+t=get_tokenizer(__target__='tokenizer_part',num_discrete=256,continuous_range=[-1,1],cls_token_id={'articulation':0},parts_token_id={'body':0,'hand':1})
+m=Qwen3ForCausalLM(Qwen3Config(vocab_size=33036,hidden_size=16,intermediate_size=32,num_hidden_layers=1,num_attention_heads=2,num_key_value_heads=1))
+install=getattr(tokenrig,'install_empty_history_repetition_guard',None)
+if install is not None:install(m)
+def processors(config):
+ config._eos_token_tensor=torch.tensor([33035]);return m._get_logits_processor(generation_config=config,input_ids_seq_length=0,encoder_input_ids=torch.empty(1,0,dtype=torch.long),device='cpu',model_kwargs={},logits_processor=tokenrig.get_logits_processor(t,33035,4,torch.tensor([t.bos,266])))
+for name,base,kwargs,expected in [('explicit',GenerationConfig(),{'repetition_penalty':2.},2.),('config_only',GenerationConfig(repetition_penalty=2.),{},2.),('config_plus_explicit',GenerationConfig(repetition_penalty=2.),{'repetition_penalty':3.},3.)]:
+ resolved,_=m._prepare_generation_config(base,**kwargs);p=processors(resolved)
+ repeat=[x for x in p if isinstance(x,RepetitionPenaltyLogitsProcessor)]
+ assert len(repeat)==1 and isinstance(repeat[0],tokenrig.EmptyHistorySafeRepetitionPenalty),(name,[type(x).__name__ for x in p])
+ s=torch.zeros((1,33036));s[0,0]=8.;out=p(torch.tensor([[0]]),s)
+ assert torch.isclose(out[0,0],torch.tensor(8./expected)),(name,out[0,0])
+ print('PASS',name,'one penalty with resolved value',expected)
+p=processors(GenerationConfig(repetition_penalty=2.,remove_invalid_values=True));assert [type(x).__name__ for x in p][:2]==['EmptyHistorySafeRepetitionPenalty','InfNanRemoveLogitsProcessor']
+s=torch.zeros((1,33036));s[0,0]=-float('inf');out=p(torch.tensor([[0]]),s);assert out[0,0]==torch.finfo(torch.float32).min,out[0,0]
